    "locomo_conv-48_qa233": {
      "question": "乔琳和妈妈的老朋友们做了什么？",
      "category": 5,
      "source_turns": {
        "D28:6": {
          "session_id": "session_28",
          "session_date": "3:09 pm on 15 September, 2023",
          "speaker": "乔琳",
          "text": "看起来玩得很开心！那天你和你妈妈的朋友们做了什么？"
        },
        "D28:7": {
          "session_id": "session_28",
          "session_date": "3:09 pm on 15 September, 2023",
          "speaker": "黛博拉",
          "text": "我们一起回忆往事，翻看她的照片。真的很温馨。"
        }
      },
      "arms": {
        "decider": {
          "jev": {
            "first": 0.24,
            "second": 0.22,
            "expanded": true
          },
          "predicted_answer": "乔琳和老朋友们一起吃了晚饭并喝酒放松，大家举杯共饮，享用美食和红酒，度过了愉快的夜晚（2023年2月21日晚）。",
          "final_context": [
            {
              "slot": 1,
              "id": "30adf307-75c4-4816-8cb9-0cecd0c60ea3",
              "content": "乔琳于2023年2月21日晚与朋友一起吃晚饭并喝酒放松，玩得很开心（有朋友举杯、食物和红酒的照片）",
              "graph_candidate": false
            },
            {
              "slot": 2,
              "id": "e7990eb8-4779-4f4b-9f82-0e87b3ca3ea6",
              "content": "乔琳以前和一个亲近的人一起烤过饼干，她最喜欢温热绵软的巧克力豆加柔软黄油饼干",
              "graph_candidate": false
            },
            {
              "slot": 3,
              "id": "99a358ca-af75-4db7-872b-292eed3fa036",
              "content": "乔琳养了一株新植物（盆栽），把它当作照顾好自己、拥抱新开始的提醒",
              "graph_candidate": false
            },
            {
              "slot": 4,
              "id": "d6af7376-6e56-4a73-942e-244aee4f3a2d",
              "content": "乔琳的伴侣从事创作事业，两人都通过追求各自的热爱来纪念逝去的亲人",
              "graph_candidate": false
            },
            {
              "slot": 5,
              "id": "081b64f8-cfd5-46a5-ac9f-eea6094daf8a",
              "content": "乔琳（黛布的朋友）在2023年5月完成了那个棘手的太阳能工程项目，做出了一个带太阳能板的太阳能动力车，她为自己在遇到诸多问题时仍坚持完成而感到自豪，认为这是一个重要里程碑",
              "graph_candidate": true
            },
            {
              "slot": 6,
              "id": "83683963-a7d3-4df5-8a2b-3d2f3454fd75",
              "content": "乔琳在艰难时期靠宠物蛇苏茜和电子游戏来安慰和消遣，她分享了一张宠物蛇蜷在手臂上的照片",
              "graph_candidate": false
            },
            {
              "slot": 7,
              "id": "7229078f-abfa-4b72-b365-5b4a05a7e1df",
              "content": "黛布向乔琳保证随时提供支持，两人约定尽快聚一聚解决乔琳的学业压力",
              "graph_candidate": true
            },
            {
              "slot": 8,
              "id": "9f60d026-6b03-43be-af41-4d7a6cbd45d2",
              "content": "乔琳和伴侣于2023年9月15日（上周五）去上了一节潜水课，玩得很开心；她希望有一天能成为认证潜水员，还找到了一个两人可以一起探索的潜水点",
              "graph_candidate": true
            },
            {
              "slot": 9,
              "id": "db10a1eb-cea3-46f6-bb8d-33d037b376eb",
              "content": "乔琳和伴侣在里约热内卢旅行期间进行了多次远足，并参观了一座古老的寺庙，那里的楼梯令人惊艳",
              "graph_candidate": false
            },
            {
              "slot": 10,
              "id": "7ce9e4c1-c5a3-4a53-8fcc-f5ef8cfcc8f0",
              "content": "乔琳（工程师）在2023年1月底（对话于2023年2月4日前一周）完成了一个重要里程碑：她通过大量规划和研究，为一个有需要的农村社区设计并建造了一台可持续的水净化器。看到它运转并为社区提供干净的水让她感到无比满足，觉得自己做了一件有意义的好事。",
              "graph_candidate": true
            },
            {
              "slot": 11,
              "id": "3b8871be-fc08-46a6-8a2b-cbbdf209866d",
              "content": "乔琳会去附近一个宁静的地方冥想（那里有一个长着睡莲的池塘和树木），冥想帮助她理清思绪、缓解压力，感觉像一次重启",
              "graph_candidate": false
            },
            {
              "slot": 12,
              "id": "69663adb-8c91-4e02-aaea-03d538dc0323",
              "content": "乔琳最近迷上了瑜伽和冥想，认为它们帮助她恢复精力、缓解紧张、带来内心平静；她已与伴侣分享了对瑜伽的热爱，并计划一起去参加冥想静修营",
              "graph_candidate": true
            },
            {
              "slot": 13,
              "id": "e5cab5cf-54d1-43ee-b174-68eed8981549",
              "content": "黛布和丈夫一起翻看家庭相册，照片在困难时期给她带来平静；她分享了一张父母1993年婚礼的照片",
              "graph_candidate": true
            },
            {
              "slot": 14,
              "id": "d2294f78-a9e3-43d2-ab3d-167bd85162f3",
              "content": "乔琳断断续续练习瑜伽和冥想约三年，认为它们对缓解压力、保持内心平静有非常积极的影响，是她度过困难时刻的重要支持",
              "graph_candidate": false
            },
            {
              "slot": 15,
              "id": "f806ef60-5f11-49fe-b50e-ac1100b6883f",
              "content": "乔琳和她都喜欢玩电子游戏；她上周（2023年1月中旬）和伴侣一起在主机上玩了《底特律》，并计划下周六（约2023年2月4日）玩《Walking Dead》；乔琳小时候就自己学会了打游戏",
              "graph_candidate": true
            }
          ]
        },
