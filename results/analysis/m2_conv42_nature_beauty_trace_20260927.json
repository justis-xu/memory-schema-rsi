  "question": {
    "question": "乔安娜和内特都欣赏什么的美？",
    "answer": "大自然",
    "evidence": [
      "D11:9",
      "D28:23"
    ],
    "category": 1
  },
  "source_turns": [
    {
      "session_id": "session_11",
      "dia_id": "D11:9",
      "speaker": "乔安娜",
      "text": "那真的很棒，内特。那个地方的声音和大自然的美让我感到非常平静安宁。其他一切都淡去了，唯一重要的就是当下。"
    },
    {
      "session_id": "session_28",
      "dia_id": "D28:23",
      "speaker": "内特",
      "text": "听起来太棒了！大自然确实总能提醒我们去欣赏身边的美，这样的时刻真的会留在心中。这些小家伙也让我感受到生活中的小确幸。你猜怎么着？我给它们找了个新朋友！"
    }
  ],
  "current_user_memory_count": 195,
  "source_session_memory_counts": {
    "session_11": 4,
    "session_28": 10
  },
  "nature_text_memory_count": 6,
  "nature_text_memories": [
    {
      "id": "3b72b542-8b22-4421-ace2-2af788f04d33",
      "session_id": "session_11",
      "content": "乔安娜说徒步为她打开了全新的世界，让她感觉像变了个人，大自然总能给她灵感，身处美景中让她觉得能写出一整部电影，并有想写一部戏剧的冲动"
    },
    {
      "id": "4ea576c4-048c-4855-abdd-292e7907889f",
      "session_id": "session_8",
      "content": "乔安娜是大自然的超级粉丝，常去徒步，大自然一直是她的避风港，在自然中漫步、聆听声音能让她平静、消除烦恼和压力"
    },
    {
      "id": "56217cd3-ace8-4857-b1cd-b79ef752e9f8",
      "session_id": "session_8",
      "content": "内特认为大自然能给人灵感，对他来说陪伴宠物和做爱好是暂时的放松方式"
    },
    {
      "id": "607518f0-1a86-4ba2-9a33-284637fcc3c2",
      "session_id": "session_1",
      "content": "乔安娜的爱好包括写作、阅读、看电影和探索大自然，但她不怎么玩电子游戏"
    },
    {
      "id": "6111d2fa-91d2-4811-8039-4a139d8cee66",
      "session_id": "session_8",
      "content": "乔安娜在2022年4月16日在自己家乡发现了一条很棒的徒步小径，觉得大自然令人振奋"
    },
    {
      "id": "e196eb2e-997b-4b67-9d7b-76409fa4f1e3",
      "session_id": "session_28",
      "content": "乔安娜分享了一张去年夏天（2021年夏）在韦恩堡附近徒步时拍的向日葵日落照片，她说日落和周围美景令人难以置信，是大自然之美的绝佳提醒"
    }
  ],
