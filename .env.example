# ===== LLM（Mem0 记忆提取 + 评测 Answerer 共用）=====
# 任何 OpenAI-compatible 端点均可。示例：
#   智谱 BigModel: https://open.bigmodel.cn/api/paas/v4 （coding 套餐: /api/coding/paas/v4）
#   OpenAI:        https://api.openai.com/v1
#   DeepSeek:      https://api.deepseek.com/v1 （无 embedding，需另配 EMBEDDING_*）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== Embedding（Mem0 向量化）=====
#   阿里百炼 compatible-mode: https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ===== Rerank（检索重排，可在 config/default.yaml 里关闭）=====
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# ===== Judge（LLM 判题，Phase 0 不启用，留空即可）=====
# 后续启用建议：judge 用比 answerer 更强的档位，降低同模型自评偏差。
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# ===== HugeGraph Server =====
HUGEGRAPH_URL=http://127.0.0.1:8080

# ===== 数据集路径覆盖（可选，默认取 config/default.yaml）=====
# LOCOMO_DATASET_PATH=data/locomo/locomo10.json
# LONGMEMEVAL_DATASET_PATH=/path/to/longmemeval_s_cleaned.json
